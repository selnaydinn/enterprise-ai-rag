GEMINI_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
#Proje köküne göre göreli yol; Docker'da ve Docker dışında aynı DB'yi gösterir
CHROMA_DIR=chroma_db_normalization
#Global token sınırı; Türkiye saatiyle TOKEN_WINDOW_HOURS saatte bir sıfırlanır (24'ü tam bölmeli)
TOKEN_LIMIT=10000
TOKEN_WINDOW_HOURS=6
#Token sayacı dosyası; proje köküne göre göreli yol
USAGE_DB_PATH=usage.db
#Gemini modeli; DB'yi etkilemez
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2
#Log seviyesi: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
#Doküman silme; kimlik doğrulama yokken herkes silebileceği için varsayılan kapalı
ALLOW_DELETE=false
#Kimlik doğrulama (tek kullanıcı). AUTH_ENABLED=true iken APP_PASSWORD ve SESSION_SECRET zorunlu, yoksa uygulama başlamaz
AUTH_ENABLED=true
#Girişte sorulacak parola
APP_PASSWORD=
#Oturum cookie'sini imzalayan gizli değer (en az 32 karakter); kimseyle paylaşılmaz, değişirse tüm oturumlar kapanır
#Üretmek için: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
#Oturum süresi (saat)
SESSION_HOURS=12
#Bulutta (HTTPS) true; yerelde (http://localhost) false
COOKIE_SECURE=false
#Diğer ayarlar (embedding modeli, chunk boyutu, k, skor barajı...) core/settings.py'de; değişirse DB yeniden kurulmalı veya eval ile ölçülmeli
