GEMINI_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
#Proje köküne göre göreli yol; Docker'da ve Docker dışında aynı DB'yi gösterir
CHROMA_DIR=chroma_db_normalization
#Global token sınırı; Türkiye saatiyle TOKEN_WINDOW_HOURS saatte bir sıfırlanır (24'ü tam bölmeli)
TOKEN_LIMIT=10000
TOKEN_WINDOW_HOURS=6
#Token sayacı dosyası; proje köküne göre göreli yol
USAGE_DB_PATH=usage.db
#Gemini modeli; DB'yi etkilemez
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2
#Log seviyesi: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
#Doküman silme; kimlik doğrulama yokken herkes silebileceği için varsayılan kapalı
ALLOW_DELETE=false
#Diğer ayarlar (embedding modeli, chunk boyutu, k, skor barajı...) core/settings.py'de; değişirse DB yeniden kurulmalı veya eval ile ölçülmeli
